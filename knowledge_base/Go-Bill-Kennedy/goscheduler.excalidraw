			"updated": 1768406725826,
			"link": null,
			"locked": false,
			"text": "- there's a total of 200ms of time available",
			"fontSize": 41.516008261708606,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- there's a total of 200ms of time available",
			"autoResize": false,
			"lineHeight": 1.25,
			"rawText": ""
		},
		{
			"id": "I30A8d7p",
			"type": "text",
			"x": -2291.4456506894785,
			"y": 92.13910290333615,
			"width": 993.9063889134094,
			"height": 259.47505163567877,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
