			"isDeleted": false,
			"boundElements": [],
			"updated": 1768406725826,
			"link": null,
			"locked": false,
			"text": "- 1000m represents full 100% of the time i.e. if\na container asks for 1000m cpu limit it needs a\nfull 100ms of core",
			"fontSize": 41.516008261708606,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- 1000m represents full 100% of the time i.e. if\na container asks for 1000m cpu limit it needs a\nfull 100ms of core",
