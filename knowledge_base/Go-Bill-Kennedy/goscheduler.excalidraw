			"link": null,
			"locked": false,
			"text": "- when the go program starts up, the Go runtime\nasks the underlying machine\n\"How many CPU cores are available for me\"",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- when the go program starts up, the Go runtime\nasks the underlying machine\n\"How many CPU cores are available for me\"",
			"autoResize": false,
			"lineHeight": 1.25,
			"rawText": ""
		},
