			"seed": 232546635,
			"version": 2267,
			"versionNonce": 1935399205,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1768406725826,
			"link": null,
			"locked": false,
			"text": "- if we ask for 1000m, then we are essentially\nasking for 100ms out of total 200ms, and we\nmight be given any of the 2 cores and the\n100ms given could be distributed across those\ncores in any proportion",
			"fontSize": 41.516008261708606,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- if we ask for 1000m, then we are essentially\nasking for 100ms out of total 200ms, and we\nmight be given any of the 2 cores and the\n100ms given could be distributed across those\ncores in any proportion",
			"autoResize": false,
			"lineHeight": 1.25,
			"rawText": ""
		},
